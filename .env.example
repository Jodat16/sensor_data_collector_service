# Copy to .env and adjust.

FLASK_SECRET_KEY=change-this

FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

LOG_LEVEL=DEBUG

MQTT_HOST=localhost
MQTT_PORT=1883
BROKER_TOPIC=service/secom/data01

# Optional -- defaults shown.
# MQTT_USERNAME=              # unset means no authentication
# MQTT_PASSWORD=
# MQTT_TLS=false
# MQTT_QOS=1                  # 1 = at-least-once, gives the broker acknowledgement
# MQTT_KEEPALIVE=60
# MQTT_PUBLISH_TIMEOUT=5.0    # seconds to wait for the broker to confirm
# MQTT_CLIENT_ID=             # empty means the broker assigns a unique id
